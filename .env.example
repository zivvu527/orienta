# Orienta environment template
# Copy this file to .env for local development. Do not commit real secrets.

# Runtime
# Local development: development
# Render production: production
NODE_ENV=development

# Local development can keep API_PORT=8787.
# Render provides PORT automatically; leave PORT empty locally.
PORT=
API_PORT=8787

# Public URLs used in emails, private question links, and production redirects.
# Render production:
# Temporary stable Render + Alibaba Cloud production entry:
# PUBLIC_SITE_URL=https://www.orienta.cn
# PUBLIC_APP_URL=https://www.orienta.cn
# Later, after the apex domain is stable, switch both back to:
# PUBLIC_SITE_URL=https://orienta.cn
# PUBLIC_APP_URL=https://orienta.cn
PUBLIC_SITE_URL=http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173

# Frontend API base URL.
# Web can leave this empty because Express serves the app and /api on the same origin.
# Production Web should also leave this empty.
# Capacitor iOS should use the public HTTPS backend:
# VITE_API_BASE_URL=https://www.orienta.cn
VITE_API_BASE_URL=

# Extra origins allowed to call the Express API.
# The server already allows https://orienta.cn and https://www.orienta.cn.
# Leave REDIRECT_TO_CANONICAL_HOSTS empty while www is the temporary stable entry.
# When orienta.cn is stable and canonical again, set:
# REDIRECT_TO_CANONICAL_HOSTS=www.orienta.cn
REDIRECT_TO_CANONICAL_HOSTS=
# Capacitor iOS uses capacitor://localhost.
CORS_ALLOWED_ORIGINS=capacitor://localhost,ionic://localhost

# OpenAI / OpenAI-compatible server-side configuration.
# Never expose these values to the Vite frontend.
OPENAI_API_KEY=your_openai_or_gateway_key
OPENAI_BASE_URL=
OPENAI_API_MODE=responses
# Text-only tasks such as Explore a Dish and Address Helper.
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Image tasks such as menu, product, and rail ticket understanding.
OPENAI_VISION_MODEL=gpt-4.1-mini
# Backward-compatible fallback if TEXT/VISION are not set.
OPENAI_MENU_MODEL=gpt-4.1-mini
OPENAI_TEXT_TIMEOUT_MS=45000
OPENAI_VISION_TIMEOUT_MS=90000
# Menu photos can contain many dishes, so this gets a longer timeout.
OPENAI_MENU_TIMEOUT_MS=240000
MAX_MENU_IMAGE_MB=8
# Server-side Chinese audio. Uses the same OPENAI_API_KEY / OPENAI_BASE_URL.
# Your OpenAI-compatible provider must support /audio/speech for this to work.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_TIMEOUT_MS=20000

# Real exchange rates are fetched server-side from three public providers.
# Each provider gets its own timeout before the next provider is tried.
EXCHANGE_RATE_PROVIDER_TIMEOUT_MS=5000
# This file keeps the last validated dataset available across server restarts.
EXCHANGE_RATE_CACHE_PATH=./server/data/exchange-rates-cache.json

# Ask a Local storage.
# Local defaults can stay under server/.
# Render persistent disk production values:
# QUESTION_DB_PATH=/var/data/orienta/data/ask-local.sqlite
# QUESTION_UPLOAD_DIR=/var/data/orienta/uploads/questions
QUESTION_DB_PATH=server/data/ask-local.sqlite
QUESTION_UPLOAD_DIR=server/private_uploads/questions

# Admin login.
# Production should use ADMIN_PASSWORD_HASH generated with:
# pnpm admin:hash "your-strong-password"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Resend email.
# Production sender domain must be verified in Resend.
# Recommended production sender:
# EMAIL_FROM=Orienta <hello@mail.orienta.cn>
RESEND_API_KEY=
EMAIL_FROM=Orienta <hello@mail.orienta.cn>
EMAIL_REPLY_TO=support@mail.orienta.cn
# Required if you want new Ask a Local questions emailed to you automatically.
ADMIN_NOTIFICATION_EMAIL=admin@example.com
EMAIL_DEV_FORCE_FAIL=
