{
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx server/index.ts",
    "dev:all": "concurrently \"pnpm dev:api\" \"pnpm dev\"",
    "admin:hash": "tsx server/createAdminPasswordHash.ts",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "test:exchange-rates": "tsx --test tests/exchangeRates.test.ts",
    "test:explore-dish": "tsx --test tests/exploreDish.test.ts",
    "build": "pnpm typecheck && tsc -p tsconfig.server.build.json && vite build",
    "start": "node server-dist/index.js",
    "cap:sync": "pnpm build && cap sync",
    "cap:ios": "cap open ios",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flag-icons": "^7.5.0",
    "lucide-react": "latest",
    "multer": "^2.2.0",
    "openai": "^6.48.0",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "^4.23.1",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
